		}
	}

	class Arvore{
    No raiz;
    public Arvore(){
        raiz=null;
    }
    public void inserir(Veiculo x){
        raiz=inserir(x,raiz);
    }
    public No inserir(Veiculo x, No i){
        if(i==null) i=new No(x);
        else if(x<i.elemento) i.esq=inserir(x,i.esq);
        else i.dir=inserir(x,i.dir);
        return i;
    }
    public void pesquisar(Veiculo x){
        if(raiz!=null) System.out.print("raiz");
	boolean aux=pesquisar(x.modelo,raiz);
	if(aux) System.out.println("SIM");
	else System.out.println("NAO");
    }
    boolean pesquisar(String modelo,No i){
        boolean aux;
        if(i==null){ 
            aux=false;
        }
        else if(i.elemento.modelo.compareTo(modelo)==0){
            aux=true;
        }
        else if(modelo.compareTo(i.elemento.modelo)<0){
            System.out.print("esq ");
            aux=pesquisar(x,i.esq);
        }
        else{
            System.out.print("dir ");
            aux=pesquisar(x,i.dir);
        }
        return aux;
    }
    void emOrdem(No i){
        if(raiz==null) System.out.println("V");
        else{
            if(i!=null){
            emOrdem(i.esq);
            System.out.print(i.elemento.format()+" ");
            emOrdem(i.dir);
            }
        }    
    }
}


